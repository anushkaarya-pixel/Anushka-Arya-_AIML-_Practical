
% Arithmetic Operations

% Addition
addition(A, B, Result) :-
    Result is A + B.

% Subtraction
subtraction(A, B, Result) :-
    Result is A - B.

% Multiplication
multiplication(A, B, Result) :-
    Result is A * B.

% Division
division(A, B, Result) :-
    B =\= 0,
    Result is A / B.

% Factorial
factorial(0, 1).

factorial(N, Result) :-
    N > 0,
    N1 is N - 1,
    factorial(N1, F),
    Result is N * F.

% Fibonacci
fibonacci(0, 0).
fibonacci(1, 1).

fibonacci(N, Result) :-
    N > 1,
    N1 is N - 1,
    N2 is N - 2,
    fibonacci(N1, F1),
    fibonacci(N2, F2),
    Result is F1 + F2.
