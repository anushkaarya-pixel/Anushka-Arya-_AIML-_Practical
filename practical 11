
% Experiment 11: Map Coloring using CSP
% Backtracking Search in Prolog

% Available colors
color(red).
color(green).
color(blue).

% Adjacent regions of Australia
adjacent(wa, nt).
adjacent(wa, sa).
adjacent(nt, sa).
adjacent(nt, q).
adjacent(sa, q).
adjacent(sa, nsw).
adjacent(sa, v).
adjacent(q, nsw).
adjacent(nsw, v).

% Check both directions of adjacency
neighbor(X, Y) :- adjacent(X, Y).
neighbor(X, Y) :- adjacent(Y, X).

% Check whether a color is valid
valid_color(_, []).

valid_color(Color, [Region-AssignedColor | Rest]) :-
    Color \= AssignedColor,
    valid_color(Color, Rest).

% Check constraints against already assigned neighbors
consistent(_, _, []).

consistent(Region, Color, [OtherRegion-OtherColor | Rest]) :-
    ( neighbor(Region, OtherRegion) ->
        Color \= OtherColor
    ;
        true
    ),
    consistent(Region, Color, Rest).

% Assign colors using backtracking
color_map([], []).

color_map([Region | Rest], [Region-Color | Assignments]) :-
    color(Color),
    color_map(Rest, Assignments),
    consistent(Region, Color, Assignments).

% Solve the map-coloring problem
solve :-
    Regions = [wa, nt, sa, q, nsw, v, t],
    color_map(Regions, Assignments),
    write('Map Coloring Solution:'), nl,
    print_solution(Assignments).

% Display the result
print_solution([]).

print_solution([Region-Color | Rest]) :-
    write(Region),
    write(' -> '),
    write(Color), nl,
    print_solution(Rest).
