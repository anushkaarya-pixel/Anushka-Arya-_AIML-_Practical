
% Graph representation using directed edges

edge(a, b).
edge(a, c).
edge(b, d).
edge(b, e).
edge(c, f).
edge(d, g).
edge(e, g).
edge(f, g).

% BFS to find shortest path

bfs(Start, Goal, Path) :-
    bfs_queue([[Start]], Goal, ReversePath),
    reverse(ReversePath, Path).

% Base case: Goal is found
bfs_queue([[Goal|Rest]|_], Goal, [Goal|Rest]).

% Recursive case
bfs_queue([Path|Queue], Goal, Result) :-
    Path = [Current|_],
    findall(
        [Next|Path],
        (edge(Current, Next), \+ member(Next, Path)),
        NewPaths
    ),
    append(Queue, NewPaths, UpdatedQueue),
    bfs_queue(UpdatedQueue, Goal, Result).
