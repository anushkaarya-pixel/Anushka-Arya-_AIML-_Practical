% A* Search
astar(Start, Goal, Path, Cost) :-
    astar_queue(
        [node(Start, [Start], 0)],
        Goal,
        ReversePath,
        Cost
    ),
    reverse(ReversePath, Path).

% Base case: Goal is reached
astar_queue(
    [node(Goal, Path, Cost)|_],
    Goal,
    Path,
    Cost
).

% Recursive case
astar_queue(
    [node(Current, Path, G)|Queue],
    Goal,
    ResultPath,
    ResultCost
) :-
    findall(
        node(Next, [Next|Path], NewG),
        (
            edge(Current, Next, EdgeCost),
            \+ member(Next, Path),
            NewG is G + EdgeCost
        ),
        NewNodes
    ),

    append(Queue, NewNodes, UpdatedQueue),

    sort_nodes(UpdatedQueue, SortedQueue),

    astar_queue(
        SortedQueue,
        Goal,
        ResultPath,
        ResultCost
    ).

% Sort nodes according to f(n) = g(n) + h(n)
sort_nodes(Nodes, Sorted) :-
    map_list_to_pairs(node_score, Nodes, Pairs),
    keysort(Pairs, SortedPairs),
    pairs_values(SortedPairs, Sorted).

% Calculate evaluation function
node_score(node(Node, _, G), F) :-
    heuristic(Node, H),
    F is G + H.
