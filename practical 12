
% N-Queens Problem using Backtracking

n_queens(N, Solution) :-
    N > 0,
    place_queens(N, 1, [], Solution).

% Base case
place_queens(N, Row, Placed, Solution) :-
    Row > N,
    reverse(Placed, Solution).

% Recursive case
place_queens(N, Row, Placed, Solution) :-
    Row =< N,
    between(1, N, Col),
    safe(Col, Row, Placed),
    NextRow is Row + 1,
    place_queens(N, NextRow,
                 [Col|Placed], Solution).

% Check safety of queen placement
safe(_, _, []).

safe(Col, Row, [PrevCol|Rest]) :-
    PrevRow is Row - 1,
    Col =\= PrevCol,
    abs(Col - PrevCol) =\= Row - PrevRow,
    safe(Col, Row, Rest).
